modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/agent-gateway: Agent Gateway"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "smoke-prod"

[[workflows.workflow]]
name = "artifacts/agent-gateway: Agent Gateway"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/agent-gateway run dev"

[[workflows.workflow]]
name = "smoke-prod"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/smoke-prod.mjs"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
