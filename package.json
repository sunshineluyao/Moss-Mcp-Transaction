{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "demo:gif": "bash scripts/make-demo-gif.sh",
    "demo:gif:capture": "APP_URL=http://localhost:23076/ node scripts/capture-demo.mjs",
    "demo:gif:success": "APP_URL=http://localhost:23076/ SCENARIO=Success OUTPUT_GIF=./assets/moss-mcp-transaction-preview-success.gif node scripts/capture-demo.mjs",
    "demo:gif:rejected": "APP_URL=http://localhost:23076/ SCENARIO='User Rejected' OUTPUT_GIF=./assets/moss-mcp-transaction-preview-rejected.gif node scripts/capture-demo.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
